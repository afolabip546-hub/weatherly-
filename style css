/* =====================================
   WEATHERLY
   Clean Mobile-First Weather UI
===================================== */


/* =====================================
   RESET
===================================== */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}


html {
  scroll-behavior: smooth;
}


body {
  min-height: 100vh;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  color: #ffffff;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #06b6d4
    );

  transition:
    background 0.6s ease;

  padding-bottom: 30px;
}


/* =====================================
   WEATHER BACKGROUNDS
===================================== */

body.sunny {
  background:
    linear-gradient(
      135deg,
      #f59e0b,
      #38bdf8
    );
}


body.cloudy {
  background:
    linear-gradient(
      135deg,
      #64748b,
      #94a3b8
    );
}


body.rainy {
  background:
    linear-gradient(
      135deg,
      #1e3a5f,
      #2563eb
    );
}


body.stormy {
  background:
    linear-gradient(
      135deg,
      #111827,
      #374151
    );
}


/* =====================================
   HEADER
===================================== */

.header {
  width: 100%;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 12px;

  padding: 18px 16px;

  background:
    rgba(255, 255, 255, 0.12);

  backdrop-filter:
    blur(12px);

  border-bottom:
    1px solid
    rgba(255, 255, 255, 0.18);

  position: sticky;
  top: 0;
  z-index: 20;
}


.logo {
  font-size: 21px;
  font-weight: 800;

  white-space: nowrap;
}


.location-button {
  border: none;

  padding: 10px 12px;

  border-radius: 12px;

  background:
    rgba(255, 255, 255, 0.2);

  color: #ffffff;

  font-size: 12px;
  font-weight: 700;

  cursor: pointer;

  transition:
    transform 0.2s ease,
    background 0.2s ease;

  white-space: nowrap;
}


.location-button:active {
  transform: scale(0.96);
}


.location-button:hover {
  background:
    rgba(255, 255, 255, 0.3);
}


.location-button:disabled {
  opacity: 0.65;
  cursor: wait;
}


/* =====================================
   MAIN CONTAINER
===================================== */

.container {
  width: min(
    100% - 28px,
    900px
  );

  margin: 0 auto;
}


/* =====================================
   SEARCH
===================================== */

.search-section {
  padding: 24px 0 18px;
}


.search-box {
  display: flex;

  width: 100%;

  background:
    rgba(255, 255, 255, 0.16);

  border:
    1px solid
    rgba(255, 255, 255, 0.22);

  border-radius: 16px;

  padding: 6px;

  backdrop-filter:
    blur(10px);
}


.search-box input {
  flex: 1;

  min-width: 0;

  border: none;
  outline: none;

  background: transparent;

  color: #ffffff;

  padding: 12px;

  font-size: 15px;
}


.search-box input::placeholder {
  color:
    rgba(255, 255, 255, 0.75);
}


.search-box button {
  border: none;

  border-radius: 12px;

  padding: 0 17px;

  background: #ffffff;

  color: #2563eb;

  font-weight: 800;

  cursor: pointer;

  transition:
    transform 0.2s ease;
}


.search-box button:active {
  transform: scale(0.96);
}


.search-box button:disabled {
  opacity: 0.6;
  cursor: wait;
}


/* =====================================
   CURRENT WEATHER
===================================== */

.current-weather {
  text-align: center;

  padding: 20px 10px 28px;
}


.location {
  font-size: 18px;

  font-weight: 700;

  opacity: 0.95;

  margin-bottom: 14px;
}


.weather-icon {
  font-size: 76px;

  line-height: 1;

  margin: 12px 0;
}


.current-weather h2 {
  font-size: 64px;

  line-height: 1;

  font-weight: 800;

  margin: 12px 0;
}


.condition {
  font-size: 17px;

  font-weight: 600;

  opacity: 0.9;
}


/* =====================================
   WEATHER DETAILS
===================================== */

.weather-details {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 10px;

  margin-bottom: 28px;
}


.detail-card {
  text-align: center;

  padding: 15px 8px;

  border-radius: 17px;

  background:
    rgba(255, 255, 255, 0.14);

  border:
    1px solid
    rgba(255, 255, 255, 0.18);

  backdrop-filter:
    blur(10px);
}


.detail-card span {
  display: block;

  font-size: 23px;

  margin-bottom: 8px;
}


.detail-card p {
  font-size: 11px;

  opacity: 0.78;

  margin-bottom: 5px;
}


.detail-card strong {
  display: block;

  font-size: 14px;
}


/* =====================================
   SECTIONS
===================================== */

.forecast-section,
.sun-section {
  margin-top: 24px;
}


.forecast-section h3,
.sun-section h3 {
  font-size: 19px;

  margin-bottom: 14px;
}


/* =====================================
   FORECAST
===================================== */

.forecast-container {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 10px;
}


.forecast-card {
  text-align: center;

  padding: 16px 8px;

  border-radius: 17px;

  background:
    rgba(255, 255, 255, 0.14);

  border:
    1px solid
    rgba(255, 255, 255, 0.18);

  backdrop-filter:
    blur(10px);

  transition:
    transform 0.2s ease;
}


.forecast-card:hover {
  transform: translateY(-3px);
}


.forecast-card p {
  font-size: 13px;

  font-weight: 700;

  margin-bottom: 12px;
}


.forecast-icon {
  font-size: 36px;

  margin-bottom: 12px;
}


.forecast-card strong {
  display: block;

  font-size: 14px;

  margin-bottom: 7px;
}


.forecast-condition {
  display: block;

  font-size: 10px;

  opacity: 0.75;

  line-height: 1.3;
}


/* =====================================
   SUNRISE / SUNSET
===================================== */

.sun-container {
  display: grid;

  grid-template-columns:
    repeat(2, 1fr);

  gap: 12px;
}


.sun-card {
  display: flex;

  flex-direction: column;

  align-items: center;

  text-align: center;

  padding: 18px;

  border-radius: 17px;

  background:
    rgba(255, 255, 255, 0.14);

  border:
    1px solid
    rgba(255, 255, 255, 0.18);

  backdrop-filter:
    blur(10px);
}


.sun-card div {
  font-size: 34px;

  margin-bottom: 8px;
}


.sun-card p {
  font-size: 12px;

  opacity: 0.78;

  margin-bottom: 5px;
}


.sun-card strong {
  font-size: 18px;
}


/* =====================================
   NOTIFICATION
===================================== */

.weather-notification {
  position: fixed;

  left: 14px;
  right: 14px;

  bottom: 20px;

  z-index: 100;

  display: flex;

  align-items: center;

  gap: 12px;

  padding: 15px;

  border-radius: 18px;

  background:
    rgba(15, 23, 42, 0.94);

  border:
    1px solid
    rgba(255, 255, 255, 0.15);

  box-shadow:
    0 12px 35px
    rgba(0, 0, 0, 0.25);

  backdrop-filter:
    blur(12px);

  transform:
    translateY(140px);

  opacity: 0;

  pointer-events: none;

  transition:
    transform 0.35s ease,
    opacity 0.35s ease;
}


.weather-notification.show {
  transform:
    translateY(0);

  opacity: 1;

  pointer-events: auto;
}


.notification-icon {
  font-size: 30px;
}


.notification-content {
  flex: 1;
}


.notification-content strong {
  display: block;

  font-size: 14px;

  margin-bottom: 4px;
}


.notification-content p {
  font-size: 12px;

  line-height: 1.4;

  opacity: 0.78;
}


.close-notification {
  width: 30px;
  height: 30px;

  border: none;

  border-radius: 50%;

  background:
    rgba(255, 255, 255, 0.1);

  color: #ffffff;

  font-size: 20px;

  cursor: pointer;
}


/* =====================================
   FOOTER
===================================== */

.footer {
  text-align: center;

  padding: 35px 15px 10px;

  opacity: 0.75;
}


.footer p {
  font-size: 15px;

  font-weight: 700;

  margin-bottom: 5px;
}


.footer span {
  font-size: 11px;
}


/* =====================================
   RESPONSIVE
===================================== */

@media (min-width: 600px) {

  .header {
    padding-left: 30px;
    padding-right: 30px;
  }


  .container {
    width: min(
      100% - 50px,
      900px
    );
  }


  .current-weather {
    padding-top: 35px;
  }


  .weather-icon {
    font-size: 95px;
  }


  .current-weather h2 {
    font-size: 82px;
  }


  .detail-card {
    padding: 20px;
  }


  .forecast-card {
    padding: 22px 15px;
  }


  .forecast-icon {
    font-size: 45px;
  }


  .weather-notification {
    left: auto;

    right: 25px;

    width: 360px;
  }
}


/* =====================================
   SMALL PHONE FIX
===================================== */

@media (max-width: 380px) {

  .logo {
    font-size: 18px;
  }


  .location-button {
    padding: 9px;

    font-size: 11px;
  }


  .current-weather h2 {
    font-size: 54px;
  }


  .weather-icon {
    font-size: 65px;
  }


  .detail-card p {
    font-size: 10px;
  }


  .detail-card strong {
    font-size: 12px;
  }


  .forecast-card p {
    font-size: 11px;
  }


  .forecast-icon {
    font-size: 30px;
  }
}
